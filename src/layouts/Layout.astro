---
// src/layouts/Layout.astro
// Plantilla HTML base con metadatos SEO, fuentes Google y estilos críticos del loader
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#c62f17" />

    <!-- Favicon Suite (favicon_io) -->
    <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon_io/site.webmanifest" />

    <!-- SEO Core -->
    <title>Energy Store — Bebidas Energéticas & Coleccionables Internacionales</title>
    <meta name="description" content="Energy Store es tu tienda especializada en bebidas energéticas internacionales, café y productos coleccionables. Descubre sabores únicos: Berry Pink, Ferno Strong, Energy Hulk y más." />
    <meta name="keywords" content="energy store, bebidas energéticas, energy drink, coleccionables, café, ferno, hulk energy, berry pink, tienda bebidas" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Javier Garin" />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href="https://web-carousel-ivory.vercel.app/" />

    <!-- Open Graph — 2026 Professional -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Energy Store" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content="https://web-carousel-ivory.vercel.app/" />
    <meta property="og:title" content="Energy Store — Bebidas Energéticas & Coleccionables" />
    <meta property="og:description" content="Explora nuestra exclusiva selección de bebidas energéticas internacionales. Sabores únicos, fórmulas extremas y diseños coleccionables. Tu próxima obsesión energética está aquí." />
    <meta property="og:image" content="https://web-carousel-ivory.vercel.app/screenshot-energy-store.png" />
    <meta property="og:image:secure_url" content="https://web-carousel-ivory.vercel.app/screenshot-energy-store.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="Energy Store — Carrusel de bebidas energéticas internacionales con diseño cinematográfico" />

    <!-- X / Twitter Card — 2026 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@energystore" />
    <meta name="twitter:creator" content="@JavGarin" />
    <meta name="twitter:url" content="https://web-carousel-ivory.vercel.app/" />
    <meta name="twitter:title" content="Energy Store — Bebidas Energéticas & Coleccionables" />
    <meta name="twitter:description" content="Explora nuestra exclusiva selección de bebidas energéticas internacionales. Sabores únicos, fórmulas extremas y diseños coleccionables." />
    <meta name="twitter:image" content="https://web-carousel-ivory.vercel.app/screenshot-energy-store.png" />
    <meta name="twitter:image:alt" content="Energy Store — Carrusel de bebidas energéticas internacionales con diseño cinematográfico" />

    <!-- Estilos críticos inline: Loader minimalista crema rosado -->
    <style>
        /* ===== RESET CRÍTICO ===== */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* ===== ANTI-FLASH: body invisible hasta que cargue ===== */
        body { opacity: 0; transition: opacity 0.1s ease; }
        body.loaded { opacity: 1; }

        /* ===== LOADER SCREEN MINIMALISTA CREMA ROSADO ===== */
        #app-loader {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #faebe7 0%, #f5dfd8 100%);
            z-index: 99999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s ease;
            user-select: none;
        }

        #app-loader.fade-out {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .loader-spinner-wrap {
            position: relative;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader-spinner {
            width: 100%;
            height: 100%;
            border: 3px solid rgba(198, 47, 23, 0.12);
            border-top: 3px solid #c62f17;
            border-right: 3px solid #ff7a45;
            border-radius: 50%;
            animation: spinEnergy 0.9s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
        }

        .loader-icon-dot {
            position: absolute;
            width: 7px;
            height: 7px;
            background: #c62f17;
            border-radius: 50%;
            box-shadow: 0 0 12px #c62f17;
            animation: pulseEnergy 1.2s ease-in-out infinite;
        }

        .loader-text {
            font-family: 'Montserrat', -apple-system, sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: #6b4d45;
            margin-left: 0.28em;
            animation: textBreath 1.8s ease-in-out infinite;
        }

        @keyframes spinEnergy {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes pulseEnergy {
            0%, 100% { transform: scale(0.8); opacity: 0.6; }
            50% { transform: scale(1.3); opacity: 1; }
        }

        @keyframes textBreath {
            0%, 100% { opacity: 0.7; }
            50% { opacity: 1; }
        }
    </style>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chelsea+Market&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
    <!-- Loading Screen Minimalista (Crema Rosado) -->
    <div id="app-loader" aria-label="Cargando Energy Store">
        <div class="loader-spinner-wrap">
            <div class="loader-spinner"></div>
            <div class="loader-icon-dot"></div>
        </div>
        <span class="loader-text">ingresando</span>
    </div>

    <slot />

    <!-- Script: body visible inmediatamente para evitar flash -->
    <script>
        document.body.classList.add('loaded');
    </script>
</body>
</html>
